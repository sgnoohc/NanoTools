Arbusto::Arbusto() {}

void Arbusto::applyRenames(TTree* tree)
{
    if (!tree) return;
    for (auto& ren : rename_branches)
    {
        // Skip if already renamed (init() runs per tree) or the branch is absent
        if (tree->GetBranch(ren.second)) continue;
        TBranch* br = tree->GetBranch(ren.first);
        if (!br) continue;
        br->SetName(ren.second);
        TObjArray* leaves = br->GetListOfLeaves();
        if (leaves && leaves->GetEntries() == 1)
        {
            static_cast<TLeaf*>(leaves->At(0))->SetName(ren.second);
        }
    }
}

Arbusto::Arbusto(TFile* new_tfile, TChain* tchain, std::vector<TString> branch_names, bool remove_branches,
                 std::vector<std::pair<TString, TString>> rename_branches) 
: remove_branches(remove_branches), branch_names(branch_names), rename_branches(rename_branches)
{
    // If remove_branches is true, this inverts the selection to drop the listed branches
    tfile = new_tfile;
    // Disable all branches
    tchain->SetBranchStatus("*", remove_branches); 
    // Enable selected branches
    for (auto branch_name : branch_names)
    {
        tchain->SetBranchStatus(branch_name, !remove_branches);
    }
    ttree = (TTree*)tchain->CloneTree(0);
    // Rename on the OUTPUT clone, not on the chain before cloning: TChain::CloneTree()
    // reloads the tree from file and discards any in-memory rename, which left the
    // output holding the old name while init() renamed the input -- CopyAddresses then
    // could not pair them ("Could not find branch named ...").
    applyRenames(ttree);
    // Snapshot the input-derived output branches before the skimmer adds its own.
    TObjArray* cloned = ttree->GetListOfBranches();
    for (int i = 0; cloned && i < cloned->GetEntries(); ++i)
    {
        cloned_branches.insert(static_cast<TBranch*>(cloned->At(i))->GetName());
    }
}

Arbusto::Arbusto(HEPCLI& cli, std::vector<TString> branch_names) 
: branch_names(branch_names)
{
    tfile = new TFile(TString(cli.output_dir+"/"+cli.output_name+".root"), "RECREATE");
    // Disable all branches
    cli.input_tchain->SetBranchStatus("*", 0); 
    // Enable selected branches
    for (auto branch_name : branch_names)
    {
        cli.input_tchain->SetBranchStatus(branch_name, 1);
    }
    ttree = (TTree*)cli.input_tchain->CloneTree(0);
    TObjArray* cloned = ttree->GetListOfBranches();
    for (int i = 0; cloned && i < cloned->GetEntries(); ++i)
    {
        cloned_branches.insert(static_cast<TBranch*>(cloned->At(i))->GetName());
    }
}

Arbusto::~Arbusto() 
{
    std::map<TString, Utilities::Dynamic*>::iterator iter;
    for(iter = branches.begin(); iter != branches.end(); ++iter)
    {
        delete (*iter).second;
    }

    branches.clear();
}

void Arbusto::init(TTree* next_ttree)
{
    // Disable all branches
    next_ttree->SetBranchStatus("*", remove_branches);
    // Enable selected branches
    for (auto branch_name : branch_names)
    {
        next_ttree->SetBranchStatus(branch_name, !remove_branches);
    }
    // Rename BEFORE CopyAddresses so input and output branch names still match
    applyRenames(next_ttree);
    next_ttree->CopyAddresses(ttree);
    orig_ttree = next_ttree;

    // A cloned output branch that is ABSENT from the new input file must read 0 for
    // this file's events, not a leftover value.
    //
    // Its output address still points at the buffer CopyAddresses shared from the
    // PREVIOUS input tree. TChain deletes that tree (and the buffers it allocated)
    // when it loads the next file, so the address dangles: zeroing it in place (the
    // old fix) wrote into freed memory, and Fill() then read whatever reused that
    // memory. Found 2026-11-07: HLT_PFMET110_PFJet100_looseRecoiling, missing from
    // one of three chained MuonEG files, came out True for all 139 of that file's
    // events after an unrelated rebuild moved the heap layout (the old binary
    // happened to read 0).
    //
    // So point such branches at a zeroed buffer Arbusto owns. When a later file has
    // the branch again, CopyAddresses above re-points it at the live input buffer.
    // Branches the skimmer adds itself are not in cloned_branches and are untouched.
    TObjArray* out_branches = ttree->GetListOfBranches();
    for (int i = 0; out_branches && i < out_branches->GetEntries(); ++i)
    {
        TBranch* out_br = static_cast<TBranch*>(out_branches->At(i));
        if (!out_br) continue;
        if (!cloned_branches.count(out_br->GetName())) continue; // skimmer-owned
        if (next_ttree->GetBranch(out_br->GetName())) continue;  // present: GetEntry fills it
        TObjArray* leaves = out_br->GetListOfLeaves();
        if (!leaves || leaves->GetEntries() != 1) continue;      // simple single-leaf branches only
        TLeaf* leaf = static_cast<TLeaf*>(leaves->At(0));
        if (!leaf) continue;
        size_t unit = leaf->GetLenType() > 0 ? leaf->GetLenType() : 0;
        if (unit == 0) continue;                                  // not a POD leaf
        // Fixed-size: LenStatic elements. Variable-size (has a count leaf, which is
        // itself absent and zeroed, so 0 elements get written): still back it with
        // room for the largest count seen, so nothing can read past the buffer.
        size_t nelem = leaf->GetLenStatic() > 0 ? leaf->GetLenStatic() : 1;
        if (TLeaf* cnt = leaf->GetLeafCount())
        {
            nelem *= static_cast<size_t>(cnt->GetMaximum() > 1024 ? cnt->GetMaximum() : 1024);
        }
        std::vector<char>& buf = absent_buffers[out_br->GetName()];
        buf.assign(unit * nelem, 0);
        out_br->SetAddress(buf.data());
    }
}

void Arbusto::fill(int entry)
{
    orig_ttree->GetEntry(entry);
    ttree->Fill();
    return;
}
